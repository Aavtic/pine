use io
use io/pretty;
use math
use time
use time/convert

fn main() {
    io.println("Hello world")
    let pi = math.pi()
    let sq = math.square(10)
    pretty.pretty_print("Hello Friend!")
    io.println("")

    io.print("The current time is: ")
    io.println(time.get_current_time())

    let seconds = convert.second("minute")

    io.print("Number of seconds in two minute is: ")
    io.printd(2 * seconds)

    let result = math.add(20, 30)
    io.printd(result)

    return if pi == 3.14 { 1 } else { 0 }
}
