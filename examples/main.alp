fn main() {
    let res = read("Are you a one or a zero?: ")

    while true {
        print("You are a ")
        print(res)
        println("!")
    }

    return 0
}

alien "c" fn pine_print(s: str) -> i32
alien "c" fn pine_println(s: str) -> i32
alien "c" fn pine_read_line_stdin(s: str) -> str

fn print(s: str) -> i32 {
    pine_print(s)
}

fn println(s: str) -> i32 {
    pine_println(s)
}

fn read(prompt: str) -> str {
    pine_read_line_stdin(prompt)
}
