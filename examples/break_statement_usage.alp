use io

fn main() {
    let state = ""
    println("Welcome to the Pine Interpreter")
    while state != "quit" {
        println("first loop")
        state = io.read(">>")
        if state == "exit" {
            while true {
                println("second loop")
                state = read(">>")
                if state == "previous" {
                    break
                }
            }
        }
        println(state)
    }
    println("Bye!")

    return 0
}
