fn main() {
    let state = ""
    println("Welcome to the Pine Interpreter")
    while state != "quit" {
        println("first loop")
        state = read(">>")
        if state == "exit" {
            while true {
                println("second loop")
                state = read(">>")
                if state == "previous" {
                    break
                }
            }
        }
        println(state)
    }
    println("Bye!")

    return 0
}

alien "c" fn pine_read_line_stdin(s: str) -> str
alien "c" fn pine_println(s: str) -> i32

fn read(s: str) -> str {
    pine_read_line_stdin(s)
}

fn println(s: str) -> i32 {
    pine_println(s)
}
